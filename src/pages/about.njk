{% extends "layouts/base.njk" %}
{% set title = "O mnie — Scandura Homes" %}
{% set nav = [
  { href: "/", label: "Strona główna" },
  { href: "/pages/about.html", label: "O mnie", active: true },
  { href: "/pages/services.html", label: "Usługi" },
  { href: "/pages/contact.html", label: "Kontakt" }
] %}

{% block content %}
<section class="about-hero">
  <div class="container">
    <h1>O mnie</h1>
      <main>

    <!-- HERO -->
    <section class="about-hero">
      <div class="about__container">

          <figure class="about-hero__photo">
          <img
            src="../photos/pages/kt-snickers-mobile.webp"
            alt="Kristoffer — założyciel Scandura Homes" />
          <!-- (opcjonalnie) własne kropki dla about; jeśli nie używasz, usuń linijkę poniżej -->
          <img src="../photos/svg/kropki1920.svg" alt="" aria-hidden="true" class="about-hero__dots" />
        </figure>

        <div class="about-hero__content">
          <h1 class="about-hero__title">Nazywam się Kristoffer</h1>
          <p class="about-hero__lead">
            Buduję nowoczesne, prefabrykowane domy szkieletowe w skandynawskim standardzie — z przejrzystą wyceną,
            terminowością i najwyższą jakością.
          </p>
          <div class="about-hero__cta">
            <a href="/pages/contact.html" class="btn btn--primary">Umów konsultację</a>
            <a href="/pages/contact.html" class="btn btn--secondary">Napisz do mnie</a>
          </div>
        </div>

      

      </div>
    </section>

    <!-- VALUES -->
    <section class="about-values">
      <div class="about__container">
        <h2 class="section-title">W co wierzę</h2>

        <div class="about-values__grid">
          <article class="value">
            <h3 class="value__title">Rzemiosło</h3>
            <p class="value__text">Detale, powtarzalność i zero prowizorki.</p>
          </article>

          <article class="value">
            <h3 class="value__title">Transparentność</h3>
            <p class="value__text">Kosztorys rozpisany linijka po linijce.</p>
          </article>

          <article class="value">
            <h3 class="value__title">Terminowość</h3>
            <p class="value__text">Harmonogram traktujemy jak kontrakt.</p>
          </article>

          <article class="value">
            <h3 class="value__title">Trwałość</h3>
            <p class="value__text">Certyfikowane materiały i kontrola jakości.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="about-timeline">
      <div class="about__container">
        <h2 class="section-title">Moja droga</h2>

        <ol class="timeline">
          <li>
            <h3>Początek</h3>
            <p>Pierwsze konstrukcje i prefabrykaty.</p>
          </li>
          <li>
            <h3>Przełom</h3>
            <p>Wdrożenie standardów skandynawskich.</p>
          </li>
          <li>
            <h3>Dzisiaj</h3>
            <p>Scandura Homes — projekty pod klucz.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="about-process">
      <div class="about__container">
        <h2 class="section-title">Jak pracuję</h2>

        <div class="process-grid">
          <article><h3>01. Brief</h3><p>Zbieramy wymagania i ograniczenia.</p></article>
          <article><h3>02. Koncepcja</h3><p>Warianty układu i technologii.</p></article>
          <article><h3>03. Wycena</h3><p>Transparentny kosztorys i harmonogram.</p></article>
          <article><h3>04. Realizacja</h3><p>Prefabrykacja + montaż na placu.</p></article>
          <article><h3>05. Odbiór</h3><p>Checklista i opieka posprzedażowa.</p></article>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="about-stats">
      <div class="about__container">
        <ul class="stats">
          <li><span class="stat__value">8+</span><span class="stat__label">lat doświadczenia</span></li>
          <li><span class="stat__value">26+</span><span class="stat__label">zrealizowanych projektów</span></li>
          <li><span class="stat__value">5.0★</span><span class="stat__label">średnia ocen</span></li>
          <li><span class="stat__value">3</span><span class="stat__label">stałe ekipy</span></li>
        </ul>
      </div>
    </section>

    <!-- FEATURED PROJECTS -->
    <section class="about-featured">
  <div class="about__container">
    <h2 class="section-title">Ostatnie projekty</h2>

    <!-- embed modułu Projects -->
    <section class="projects projects--embed" aria-label="Ostatnie projekty">
      <div class="projects__cards-container">
        <!-- użyj tych samych kart co na index (project-card) -->
        <article class="project-card">
          <div class="project-card__image-wrapper">
            <img src="../photos/projects/slide1.png" alt="" class="project-card__image">
          </div>
          <div class="project-card__content">
            <div class="project-card__header-info">
              <img src="../photos/svg/arrow.svg" alt="" class="project-card__header-arrow" width="24" height="24">
              <span class="project-card__header-number project-card__header-number--current">01</span>
              <img src="../photos/svg/vector60.svg" alt="" class="project-card__header-divider-img" width="138" height="2">
              <span class="project-card__header-number">02</span>
            </div>
            <h3 class="project-card__title">Greenwood Estates</h3>
            <p class="project-card__description">Opis projektu…</p>
            <div class="project-card__meta">
              <div class="project-card__meta-item">
                <span class="project-card__meta-label">Location</span>
                <span class="project-card__meta-value">Downtown City Center</span>
              </div>
              <div class="project-card__meta-item">
                <span class="project-card__meta-label">Scope</span>
                <span class="project-card__meta-value">Office Complex Development</span>
              </div>
            </div>
            <a href="#" class="project-card__button">See Details</a>
          </div>
        </article>

        <!-- …kolejne <article class="project-card"> tak jak w projects … -->
      </div>
    </section>
  </div>
</section>


   <!-- OPINIE — embed modułu z index -->
<section class="about-testimonials">
  <div class="about__container">
    <!-- ważne: sekcja .testimonials jest bezpośrednim dzieckiem grida -->
    <section class="testimonials testimonials--embed" aria-label="Opinie klientów">
      <div class="container">
        <h2 class="testimonials__title">What our clients say?</h2>

        <div class="testimonials__slider">
          <!-- brakowało tego wrappera: -->
          <div class="testimonials__track">
            <!-- SLIDE 1 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Zadowolony klient przed domem" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Zespół Scandura Homes od początku wpierał nas w każdej decyzji. Nasz dom został wykonany z najwyższą jakością."</h3>
                <p class="testimonials__text">"Precyzyjna budowa, świetna komunikacja i transparentność w kosztach. Jesteśmy zachwyceni naszym nowym domem."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Katarzyna M. Warsaw</strong><span>Doctor</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 2 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Klient przed nowym domem" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Profesjonalna ekipa i terminowość."</h3>
                <p class="testimonials__text">"Proces od projektu po odbiór przebiegł bez stresu. Polecam każdemu."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Michał K. Gdańsk</strong><span>Inżynier</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 3 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Rodzina przed domem" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Świetny kontakt i doradztwo."</h3>
                <p class="testimonials__text">"Pomogli dobrać rozwiązania pod nasz budżet i styl życia."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Anna &amp; Piotr, Oslo</strong><span>IT / Nauczycielka</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 4 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Szczegóły wykończenia" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Jakość wykończenia top."</h3>
                <p class="testimonials__text">"Każdy detal dopracowany, zero kompromisów w materiałach."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Ola T., Trondheim</strong><span>Architekt</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 5 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Inwestor przy budowie" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Przejrzyste koszty i harmonogram."</h3>
                <p class="testimonials__text">"Zero ukrytych pozycji, wszystko opisane w umowie."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Jakub W., Melhus</strong><span>Przedsiębiorca</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 6 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Nowy dom parterowy" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Szybko i rzetelnie."</h3>
                <p class="testimonials__text">"Termin dotrzymany mimo trudnych warunków pogodowych."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Marcin R., Warsaw</strong><span>Lekarz</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 7 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Salon w domu" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Świetna współpraca z projektantem."</h3>
                <p class="testimonials__text">"Elastycznie dopasowali układ pomieszczeń do naszych potrzeb."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Klaudia S., Bærum</strong><span>UX Designer</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 8 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Taras drewniany" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Bardzo dobra ekipa montażowa."</h3>
                <p class="testimonials__text">"Czysto na budowie, prace szły jak w zegarku."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Paweł P., Gdynia</strong><span>Logistyk</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 9 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Elewacja domu" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Kontakt po odbiorze na plus."</h3>
                <p class="testimonials__text">"Szybko reagują na pytania i drobne poprawki gwarancyjne."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Ewelina Z., Sopot</strong><span>Marketing</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>

            <!-- SLIDE 10 -->
            <div class="testimonials__slide">
              <div class="testimonials__image-wrapper">
                <img src="../photos/main/opinie.jpg" alt="Wejście do domu" class="testimonials__image">
              </div>
              <div class="testimonials__card">
                <h3 class="testimonials__headline">"Rekomendujemy znajomym."</h3>
                <p class="testimonials__text">"Świetna relacja ceny do jakości i pełne wsparcie."</p>
                <div class="testimonials__stars">★★★★★</div>
                <p class="testimonials__author"><strong>Monika &amp; Adam, Kraków</strong><span>Analityk / Prawnik</span></p>
                <div class="testimonials__line"></div>
              </div>
            </div>
          </div><!-- /.testimonials__track -->
        </div><!-- /.testimonials__slider -->

        <div class="testimonials__nav">
          <button class="testimonials__arrow testimonials__arrow--prev" aria-label="Poprzednia opinia">
            <img src="../photos/svg/arow-left-testim.svg" alt="Poprzednia opinia">
          </button>
          <button class="testimonials__arrow testimonials__arrow--next" aria-label="Następna opinia">
            <img src="../photos/svg/arow-right-testim.svg" alt="Następna opinia">
          </button>
        </div>
      </div>
    </section>
  </div>
</section>


<section class="about-cta">
  <div class="container">
    {% include "partials/_ai-box.njk" %}
  </div>
</section>


  </main>
  </div>
</section>



{% endblock %}

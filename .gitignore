.vscode/
.idea/
*.swp
*.swo

# --- Backup / Temp ---
*.bak
*.tmp
*.temp
*~
*.old

# --- Local caches ---
.cache/
.parcel-cache/
.next/
out/

# --- Projektowe duże pliki ---
photos/header_video.mp4
# --- Windows duplicate files ---
css/style(*).css
css/style(*).map
dist/
css/*.map
.sass-cache/
.cache/

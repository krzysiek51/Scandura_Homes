# ==========================================
# SCANDURA HOMES - .gitignore
# ==========================================

# --- Build artefakty ---
dist/
css/*.map
*.log

# --- Node / NPM ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS Junk ---
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

# --- IDE Junk ---
.vscode/
.idea/
*.swp
*.swo

# --- Backup / Temp ---
*.bak
*.tmp
*.temp
*~
*.old

# --- Local caches ---
.cache/
.parcel-cache/
.next/
out/

# # --- Projektowe duże pliki ---
# photos/header_video.mp4
# --- Windows duplicate files ---
css/style(*).css
css/style(*).map
css/*.map
.sass-cache/

git rm --cached scandura-booking/google-token.json
echo scandura-booking/google-token.json>> .gitignore
git add .gitignore
scandura-booking/google-token.json
bfg.jar
photos/svg/OpenJDK21U-jdk_aarch64_windows_hotspot_21.0.8_9.zip
photos/svg/OpenJDK21U-jdk_aarch64_windows_hotspot_21.0.8_9/

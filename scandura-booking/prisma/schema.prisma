datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  type   BookingType
  status BookingStatus @default(PENDING)

  startAt DateTime
  endAt   DateTime
  tz      String

  address String? // dla spotkań na żywo
  notes   String?

  // Google Calendar
  googleEventId String? // <-- DODANE POLE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacja w drugą stronę (jedna rezerwacja może mieć kilka tokenów)
  rescheduleTokens RescheduleToken[]

  @@index([startAt])
  @@index([status])
}

model RescheduleToken {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id])
  bookingId String

  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

enum BookingType {
  IN_PERSON
  ONLINE
  PHONE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}
